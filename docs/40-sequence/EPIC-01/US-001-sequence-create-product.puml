@startuml
title US-001 — Create Product (POST /api/v1/products)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #3366CC
  ActorBorderColor #F9A825
  LifeLineBorderColor #AAAAAA
  ParticipantBackgroundColor #EEF3FF
  ParticipantBorderColor #3366CC
  DatabaseBackgroundColor #E8F5E9
  DatabaseBorderColor #388E3C
  BoxBackgroundColor #F9F9F9
}

actor "Store Manager" as Manager
participant "ProductResource\n<<@Path /api/v1/products>>" as API
participant "ProductService\n<<@ApplicationScoped>>" as Service
participant "ProductRepository\n<<@ApplicationScoped>>" as Repo
database "PostgreSQL" as DB

Manager -> API : POST /api/v1/products\nContent-Type: application/json\n{ sku, name, price, stock }

activate API
note right of API : Bean Validation fires here.\nInvalid payload → 400 immediately.

API -> Service : create(CreateProductRequest)
activate Service

Service -> Repo : findBySku(sku)
activate Repo
Repo -> DB : SELECT * FROM product WHERE sku = ?
DB --> Repo : ResultSet
deactivate Repo

alt SKU already exists
  Service --> API : throw IllegalStateException\n("SKU already exists")
  deactivate Service
  API --> Manager : HTTP 409 Conflict\n{ "error": "Product with SKU TV-1 already exists" }
else SKU is available
  Service -> Repo : persist(ProductEntity)
  activate Repo
  Repo -> DB : INSERT INTO product (sku, name, price, stock)\nVALUES (?, ?, ?, ?)
  DB --> Repo : OK (generated id)
  deactivate Repo
  Service --> API : ProductDTO
  deactivate Service
  API --> Manager : HTTP 201 Created\nLocation: /api/v1/products/{sku}\n{ sku, name, price, stock }
end

deactivate API
@enduml
