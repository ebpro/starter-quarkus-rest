@startuml
title US-003 — Delete Product (DELETE /api/v1/products/{sku})

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #3366CC
  ActorBorderColor #F9A825
  LifeLineBorderColor #AAAAAA
  ParticipantBackgroundColor #EEF3FF
  ParticipantBorderColor #3366CC
  DatabaseBackgroundColor #E8F5E9
  DatabaseBorderColor #388E3C
}

actor "Store Manager" as Manager
participant "ProductResource\n<<@Path /api/v1/products>>" as API
participant "ProductService\n<<@ApplicationScoped>>" as Service
participant "ProductRepository\n<<@ApplicationScoped>>" as Repo
database "PostgreSQL" as DB

Manager -> API : DELETE /api/v1/products/TV-1
activate API

API -> Service : delete("TV-1")
activate Service

Service -> Repo : findBySku("TV-1")
activate Repo
Repo -> DB : SELECT * FROM product WHERE sku = 'TV-1'
DB --> Repo : ResultSet
deactivate Repo

alt Product exists
  Service -> Repo : deleteById(entity.id)
  activate Repo
  Repo -> DB : DELETE FROM product WHERE id = ?
  DB --> Repo : 1 row deleted
  deactivate Repo
  Service --> API : void (success)
  deactivate Service
  API --> Manager : HTTP 204 No Content\n(empty body)

  note over Manager
    A subsequent GET /api/v1/products/TV-1
    will return 404 Not Found
  end note
else Product not found
  Service --> API : throw NotFoundException\n("Product TV-1 not found")
  deactivate Service
  API --> Manager : HTTP 404 Not Found\n{ "error": "Product TV-1 not found" }
end

deactivate API
@enduml
