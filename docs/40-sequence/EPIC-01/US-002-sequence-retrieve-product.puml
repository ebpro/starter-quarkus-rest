@startuml
title US-002 — Retrieve Product (GET /api/v1/products & GET /api/v1/products/{sku})

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #3366CC
  ActorBorderColor #F9A825
  LifeLineBorderColor #AAAAAA
  ParticipantBackgroundColor #EEF3FF
  ParticipantBorderColor #3366CC
  DatabaseBackgroundColor #E8F5E9
  DatabaseBorderColor #388E3C
}

actor "Store Manager" as Manager
participant "ProductResource\n<<@Path /api/v1/products>>" as API
participant "ProductService\n<<@ApplicationScoped>>" as Service
participant "ProductRepository\n<<@ApplicationScoped>>" as Repo
database "PostgreSQL" as DB

group Retrieve all products — GET /api/v1/products
  Manager -> API : GET /api/v1/products\nAccept: application/json
  activate API
  API -> Service : findAll()
  activate Service
  Service -> Repo : listAll()
  activate Repo
  Repo -> DB : SELECT * FROM product ORDER BY sku
  DB --> Repo : List<ProductEntity>
  deactivate Repo
  Service --> API : List<ProductDTO>
  deactivate Service
  API --> Manager : HTTP 200 OK\n[ { sku, name, price, stock }, ... ]
  deactivate API
end

group Retrieve by SKU — GET /api/v1/products/{sku}
  Manager -> API : GET /api/v1/products/TV-1\nAccept: application/json
  activate API
  API -> Service : findBySku("TV-1")
  activate Service
  Service -> Repo : findBySku("TV-1")
  activate Repo
  Repo -> DB : SELECT * FROM product WHERE sku = 'TV-1'
  DB --> Repo : ResultSet
  deactivate Repo

  alt Product found
    Service --> API : Optional<ProductDTO> (present)
    deactivate Service
    API --> Manager : HTTP 200 OK\n{ sku, name, price, stock }
  else Product not found
    Service --> API : Optional.empty()
    deactivate Service
    API --> Manager : HTTP 404 Not Found\n{ "error": "Product TV-1 not found" }
  end

  deactivate API
end
@enduml
