@startuml
title Product Catalog — Technical Dependencies
left to right direction

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF3FF
  BorderColor #3366CC
  FontSize 11
}
skinparam rectangle {
  BackgroundColor #F9F9F9
  BorderColor #AAAAAA
}

rectangle "Runtime: Quarkus 3.x (JVM)" as Quarkus {
  component "JAX-RS / REST\n(quarkus-rest-jackson)" as REST
  component "CDI / ARC\n(quarkus-arc)" as CDI
  component "Hibernate ORM + Panache\n(quarkus-hibernate-orm-rest-data-panache)" as ORM
  component "Bean Validation\n(quarkus-hibernate-validator)" as VALIDATION
  component "SmallRye OpenAPI\n(quarkus-smallrye-openapi)" as OPENAPI
  component "SmallRye Health\n(quarkus-smallrye-health)" as HEALTH
  component "REST Client\n(quarkus-rest-client-jackson)" as RESTCLIENT
}

rectangle "Application Layers" {
  component "API\n(ProductResource\nExceptionMappers)" as API
  component "Application\n(ProductService, DTOs)" as APP
  component "Domain\n(Product — pure Java)" as DOMAIN
  component "Infrastructure\n(Repository, Entity, Mapper)" as INFRA
}

database "PostgreSQL 16\n(JDBC: quarkus-jdbc-postgresql)" as DB

rectangle "Test Scope" {
  component "Cucumber 7\n(quarkus-cucumber + cucumber-java)" as CUCUMBER
  component "Testcontainers\n(PostgreSQL container)" as TC
  component "ArchUnit 1.x\n(layer & naming rules)" as ARCHUNIT
  component "REST Assured\n(HTTP assertions)" as RESTASSURED
  component "Mockito\n(unit test mocks)" as MOCKITO
}

REST --> API
CDI --> API
CDI --> APP
ORM --> INFRA
VALIDATION --> APP
OPENAPI --> API
HEALTH --> API
RESTCLIENT --> INFRA

API --> APP
APP --> DOMAIN
APP --> INFRA
INFRA --> DB

CUCUMBER --> API : acceptance tests
TC --> DB : real DB in tests
ARCHUNIT --> APP : layer rules
RESTASSURED --> API : HTTP assertions
MOCKITO --> APP : unit isolation

note bottom of DOMAIN
  Zero runtime framework deps.
  Depends only on java.base.
end note
@enduml
